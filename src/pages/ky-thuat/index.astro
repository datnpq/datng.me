---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { CATEGORIES } from "@/data/categories";
import { getCategoryPosts } from "@/utils/getCategoryPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const posts = await getCollection("posts");
const sections = CATEGORIES.map(c => ({ ...c, posts: getCategoryPosts(posts, c.slug) }));
const total = sections.reduce((n, s) => n + s.posts.length, 0);
---

<Layout
  title={`Kỹ thuật | ${config.site.title}`}
  description="Những bài kỹ thuật cơ bản, chia theo mục: VPS, Linux, DNS, web server, bảo mật, web tĩnh, home lab."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Kỹ thuật"
    pageDesc={`Ghi chép kỹ thuật cơ bản, viết cho người mới và cho chính mình sau này đỡ phải tra lại. ${total} bài, chia theo ${CATEGORIES.length} mục, đọc từ trên xuống là vừa.`}
  >
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        sections.map(s => (
          <section class="border-border min-w-0 rounded-md border p-4">
            <h2 class="text-lg font-semibold">
              <a
                href={`/ky-thuat/${s.slug}/`}
                class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
              >
                <span aria-hidden="true">{s.icon}</span> {s.name}
              </a>
              <span class="text-muted-foreground ms-1 text-sm font-normal">
                ({s.posts.length})
              </span>
            </h2>
            <p class="text-muted-foreground mt-1 text-sm">{s.desc}</p>
            {s.posts.length ? (
              <ol class="mt-3 list-decimal ps-5 text-sm">
                {s.posts.slice(0, 5).map(p => (
                  <li class="my-1">
                    <a
                      href={getPostUrl(p.id, p.filePath)}
                      class="text-accent decoration-dashed underline-offset-4 hover:underline"
                    >
                      {p.data.title}
                    </a>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="text-muted-foreground mt-3 text-sm italic">Đang viết…</p>
            )}
            {s.posts.length > 5 && (
              <a href={`/ky-thuat/${s.slug}/`} class="text-accent mt-2 inline-block text-sm">
                Xem hết {s.posts.length} bài →
              </a>
            )}
          </section>
        ))
      }
    </div>
  </Main>
  <Footer />
</Layout>
