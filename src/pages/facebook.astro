---
/**
 * "datbook" — a 2010-style Facebook wall rebuilt from the owner's own
 * data export, after the real account was disabled on 6/11/2026.
 * Standalone page: no blog header/theme. Data: src/data/facebook/wall.json
 * (generated by scripts/import-facebook.mjs). Images: src/assets/images/fb-wall/.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import wall from "@/data/facebook/wall.json";

type Comment = { author: string; text: string; date?: string };
type Post = {
  id: string;
  date: string;
  kind: "status" | "photo" | "event" | "link";
  text: string;
  images: string[];
  link?: string;
  likes: number;
  comments: Comment[];
  hidden?: boolean;
};

const files = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/fb-wall/**/*.{jpg,jpeg,png,webp}",
  { eager: true }
);
const img = (name: string) =>
  files[`/src/assets/images/fb-wall/${name}`]?.default;

const { profile, friends } = wall;
const posts = (wall.posts as Post[])
  .filter(p => !p.hidden)
  .sort((a, b) => +new Date(b.date) - +new Date(a.date));
const photos = posts.flatMap(p =>
  p.images.map(name => ({ name, meta: img(name), post: p }))
).filter(p => p.meta);

const tz = "Asia/Ho_Chi_Minh";
const fmtDate = (iso: string) => {
  const d = new Date(iso);
  const day = new Intl.DateTimeFormat("vi-VN", {
    timeZone: tz, weekday: "long", day: "numeric", month: "numeric", year: "numeric",
  }).format(d);
  const time = new Intl.DateTimeFormat("vi-VN", {
    timeZone: tz, hour: "2-digit", minute: "2-digit", hour12: false,
  }).format(d);
  return `${day} lúc ${time}`;
};
const year = (iso: string) =>
  new Intl.DateTimeFormat("en", { timeZone: tz, year: "numeric" }).format(new Date(iso));
const initials = (name: string) =>
  name.split(/\s+/).map(w => w[0]).join("").slice(0, 2).toUpperCase();

const disabled = new Intl.DateTimeFormat("vi-VN", {
  timeZone: tz, day: "numeric", month: "numeric", year: "numeric",
}).format(new Date(profile.disabledAt));
const years = [...new Set(posts.map(p => year(p.date)))];
const PAGE = 15;
const title = `${profile.name} | datbook`;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={`Bản lưu tường Facebook của ${profile.name}, tài khoản bị vô hiệu hoá ngày ${disabled}.`} />
    <meta property="og:title" content={title} />
    <meta property="og:image" content="/avatar.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="bar">
      <div class="wrap bar-in">
        <a class="logo" href="/facebook/">datbook</a>
        <input class="search" type="search" placeholder="Tìm kiếm" disabled aria-label="Tìm kiếm (đã tắt)" />
        <nav class="bar-links">
          <a href="/facebook/">Trang chủ</a>
          <a href="/facebook/">Hồ sơ</a>
          <a href="/">← Về datng.me</a>
        </nav>
      </div>
    </header>

    <div class="notice">
      <div class="wrap">
        <strong>Tài khoản này đã bị vô hiệu hoá ngày {disabled}.</strong>
        Đây là bản lưu tường, dựng lại từ dữ liệu chủ nhân tự tải về.
        Đọc chuyện ở <a href="/posts/facebook-17-nam-bi-vo-hieu-hoa/">bài viết này</a>.
        {wall.sample && <em class="sample"> (Đang hiện dữ liệu mẫu.)</em>}
      </div>
    </div>

    <main class="wrap page">
      <!-- Left column -->
      <aside class="left">
        <img class="profile-pic" src="/avatar.jpg" alt={`Ảnh đại diện của ${profile.name}`} width="180" height="180" />
        <div class="actions">
          <button disabled>Viết lên tường</button>
          <button disabled>Gửi tin nhắn</button>
        </div>
        <div class="box">
          <h3>Thông tin</h3>
          <dl>
            {profile.info.map(([k, v]) => (
              <>
                <dt>{k}</dt>
                <dd>{v.startsWith("http") ? <a href={v}>{v.replace(/^https?:\/\//, "")}</a> : v}</dd>
              </>
            ))}
          </dl>
        </div>
        <div class="box">
          <h3>Bạn bè <span class="muted">({friends.total})</span></h3>
          <ul class="friends">
            {friends.list.slice(0, 6).map(f => (
              <li><span class="sil" aria-hidden="true">{initials(f.name)}</span><span class="fname">{f.name}</span></li>
            ))}
          </ul>
        </div>
      </aside>

      <!-- Main column -->
      <section class="main">
        <h1>{profile.name} <span class="status">{profile.status}</span></h1>

        <nav class="tabs" role="tablist">
          <button role="tab" aria-selected="true" data-tab="wall">Tường</button>
          <button role="tab" aria-selected="false" data-tab="info">Thông tin</button>
          <button role="tab" aria-selected="false" data-tab="photos">Ảnh <span class="muted">({photos.length})</span></button>
        </nav>

        <div data-panel="wall">
          <div class="publisher">
            <input disabled placeholder="Bạn đang nghĩ gì?" aria-label="Đăng trạng thái (đã tắt)" />
            <button disabled>Chia sẻ</button>
          </div>

          {years.length > 1 && (
            <div class="years">
              {years.map(y => <a href={`#y${y}`}>{y}</a>)}
            </div>
          )}

          <ol class="stream">
            {posts.map((p, i) => {
              const firstOfYear = i === 0 || year(posts[i - 1].date) !== year(p.date);
              return (
                <li class:list={["story", p.kind, { more: i >= PAGE }]} id={firstOfYear ? `y${year(p.date)}` : undefined} data-likes={p.likes}>
                  <img class="av" src="/avatar.jpg" alt="" width="50" height="50" loading="lazy" />
                  <div class="body">
                    {p.kind === "event"
                      ? <p class="event">★ <a href="/facebook/">{profile.name}</a> {p.text}</p>
                      : <p><a class="name" href="/facebook/">{profile.name}</a> <span class="text">{p.text}</span></p>}
                    {p.link && <a class="att-link" href={p.link} rel="nofollow noopener">{p.link}</a>}
                    {p.images.length > 0 && (
                      <div class:list={["imgs", { single: p.images.length === 1 }]}>
                        {p.images.slice(0, 4).map(name => {
                          const meta = img(name);
                          return meta && (
                            <Image src={meta} alt="" width={p.images.length === 1 ? 398 : 130} loading="lazy" />
                          );
                        })}
                      </div>
                    )}
                    <div class="meta">
                      <time datetime={p.date}>{fmtDate(p.date)}</time> ·
                      <button class="lk" data-like>Thích</button> ·
                      <span>Bình luận</span>
                    </div>
                    <div class="ufi">
                      <div class="likes" data-like-line hidden={p.likes === 0}>
                        👍 <span data-like-count>{p.likes}</span> người thích điều này.
                      </div>
                      {p.comments.map(c => (
                        <div class="cmt">
                          <span class="sil sm" aria-hidden="true">{initials(c.author)}</span>
                          <p><b>{c.author}</b> {c.text}{c.date && <span class="cdate"> {fmtDate(c.date)}</span>}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                </li>
              );
            })}
          </ol>
          {posts.length > PAGE && <button class="older" data-older>Bài đăng cũ hơn</button>}
        </div>

        <div data-panel="info" hidden>
          <div class="box wide">
            <h3>Thông tin cơ bản</h3>
            <dl>
              {profile.info.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
              <dt>Bài đăng</dt><dd>{posts.length}</dd>
              <dt>Bạn bè</dt><dd>{friends.total}</dd>
              <dt>Vô hiệu hoá</dt><dd>{disabled}</dd>
            </dl>
          </div>
        </div>

        <div data-panel="photos" hidden>
          {photos.length === 0
            ? <p class="muted pad">Chưa có ảnh nào.</p>
            : <div class="grid">
                {photos.map(ph => <Image src={ph.meta!} alt="" width={160} height={160} loading="lazy" />)}
              </div>}
        </div>
      </section>

      <!-- Right column -->
      <aside class="right">
        <div class="box">
          <h3>Được tài trợ</h3>
          <a class="ad" href="/">
            <b>datng.me</b>
            <span>Blog không ai khoá được. Tên miền riêng, bài viết là file Markdown.</span>
          </a>
          <a class="ad" href="/posts/hanh-trinh-lam-web-tu-2008/">
            <b>Làm web từ 2008</b>
            <span>teenstyle9x.info, diễn đàn A12, blog Yahoo! 360…</span>
          </a>
        </div>
      </aside>
    </main>

    <footer class="wrap foot">datbook © 2009–2026 · Bản lưu không chính thức, không liên quan tới Meta · <a href="/">datng.me</a></footer>

    <script>
      // Tabs
      const tabs = document.querySelectorAll<HTMLButtonElement>("[data-tab]");
      tabs.forEach(t =>
        t.addEventListener("click", () => {
          tabs.forEach(o => o.setAttribute("aria-selected", String(o === t)));
          document.querySelectorAll<HTMLElement>("[data-panel]").forEach(p => {
            p.hidden = p.dataset.panel !== t.dataset.tab;
          });
        })
      );
      // "Bài đăng cũ hơn": reveal next batch
      document.querySelector("[data-older]")?.addEventListener("click", e => {
        const hidden = [...document.querySelectorAll(".story.more")].slice(0, 15);
        hidden.forEach(el => el.classList.remove("more"));
        if (!document.querySelector(".story.more")) (e.currentTarget as HTMLElement).remove();
      });
      // Year jump also reveals everything up to that year
      document.querySelectorAll<HTMLAnchorElement>(".years a").forEach(a =>
        a.addEventListener("click", () => document.querySelectorAll(".story.more").forEach(el => el.classList.remove("more")))
      );
      // Like (local only, just for fun)
      document.querySelectorAll<HTMLButtonElement>("[data-like]").forEach(btn =>
        btn.addEventListener("click", () => {
          const story = btn.closest<HTMLElement>(".story")!;
          const liked = btn.classList.toggle("on");
          btn.textContent = liked ? "Bỏ thích" : "Thích";
          const n = Number(story.dataset.likes) + (liked ? 1 : 0);
          const line = story.querySelector<HTMLElement>("[data-like-line]")!;
          line.hidden = n === 0;
          story.querySelector("[data-like-count]")!.textContent = liked && n === 1 ? "Bạn" : String(n);
        })
      );
    </script>

    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; background: #fff; color: #333; }
      body { font: 11px/1.38 "lucida grande", tahoma, verdana, arial, sans-serif; }
      a { color: #3b5998; text-decoration: none; }
      a:hover { text-decoration: underline; }
      h1, h3, p, dl, ol, ul { margin: 0; padding: 0; }
      ul, ol { list-style: none; }
      button { font: inherit; }
      .wrap { width: 980px; max-width: 100%; margin: 0 auto; padding: 0 10px; }
      .muted { color: #999; font-weight: normal; }
      .pad { padding: 12px 0; }

      .bar { background: #3b5998; border-bottom: 1px solid #133783; height: 41px; }
      .bar-in { display: flex; align-items: center; gap: 14px; height: 41px; }
      .logo { color: #fff; font: bold 23px/1 "klavika", "lucida grande", tahoma, sans-serif; letter-spacing: -1px; }
      .logo:hover { text-decoration: none; }
      .search { width: 260px; height: 21px; border: 1px solid #1d4088; padding: 0 5px; font: inherit; background: #fff; }
      .bar-links { margin-left: auto; display: flex; gap: 2px; }
      .bar-links a { color: #fff; font-weight: bold; padding: 4px 7px; }
      .bar-links a:hover { background: #6d84b4; text-decoration: none; }

      .notice { background: #fff9d7; border-bottom: 1px solid #e2c822; padding: 8px 0; }
      .notice .sample { color: #a00; }

      .page { display: grid; grid-template-columns: 180px 1fr 200px; gap: 20px; padding-top: 14px; padding-bottom: 30px; }
      .profile-pic { width: 180px; height: auto; display: block; border: 1px solid #ccc; }
      .actions { display: flex; flex-direction: column; gap: 3px; margin: 8px 0 12px; }
      .actions button, .publisher button { background: #f2f2f2; border: 1px solid #ccc; color: #333; font-weight: bold; padding: 3px 6px; text-align: left; cursor: not-allowed; }
      .box { border-top: 1px solid #94a3c4; margin-bottom: 14px; }
      .box h3 { background: #eceff5; color: #333; font-size: 11px; font-weight: bold; padding: 3px 5px; }
      .box dl { display: grid; grid-template-columns: auto 1fr; gap: 4px 8px; padding: 6px 4px; }
      .box dt { color: #808080; }
      .box dd { margin: 0; overflow-wrap: anywhere; }
      .box.wide dl { grid-template-columns: 140px 1fr; }

      .friends { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px 4px; padding: 6px 0; }
      .friends li { display: flex; flex-direction: column; align-items: center; gap: 2px; text-align: center; }
      .fname { color: #3b5998; font-size: 10px; }
      .sil { width: 50px; height: 50px; display: grid; place-items: center; background: #d8dfea; color: #fff; font-weight: bold; font-size: 14px; border: 1px solid #c4cde0; }
      .sil.sm { width: 32px; height: 32px; font-size: 10px; flex: none; }

      .main h1 { font-size: 18px; font-weight: bold; color: #333; padding-bottom: 6px; }
      .status { font-size: 13px; font-weight: normal; color: #333; }
      .tabs { display: flex; gap: 2px; border-bottom: 1px solid #898989; margin: 4px 0 12px; }
      .tabs button { background: #d8dfea; border: 1px solid #d8dfea; border-bottom: 0; color: #3b5998; font-weight: bold; padding: 4px 10px; cursor: pointer; }
      .tabs button[aria-selected="true"] { background: #fff; border-color: #898989; color: #333; margin-bottom: -1px; padding-bottom: 5px; }

      .publisher { display: flex; gap: 6px; padding-bottom: 12px; border-bottom: 1px solid #e9e9e9; }
      .publisher input { flex: 1; border: 1px solid #bdc7d8; padding: 4px; font: inherit; }
      .years { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 0; border-bottom: 1px solid #e9e9e9; }

      .story { display: flex; gap: 10px; padding: 10px 0; border-bottom: 1px solid #e9e9e9; }
      .story.more { display: none; }
      .av { width: 50px; height: 50px; flex: none; object-fit: cover; }
      .body { flex: 1; min-width: 0; }
      .name { font-weight: bold; }
      .text { white-space: pre-line; overflow-wrap: anywhere; }
      .event { color: #333; }
      .event a { font-weight: bold; }
      .att-link { display: block; margin-top: 6px; border-left: 2px solid #ccc; padding-left: 8px; overflow-wrap: anywhere; }
      .imgs { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
      .imgs img { height: auto; border: 1px solid #ccc; }
      .imgs:not(.single) img { width: 130px; height: 130px; object-fit: cover; }
      .imgs.single img { max-width: 100%; }
      .meta { color: #999; margin-top: 5px; }
      .meta .lk { background: none; border: 0; padding: 0; color: #3b5998; cursor: pointer; }
      .meta .lk:hover { text-decoration: underline; }
      .meta span { color: #3b5998; }
      .ufi > * { background: #edeff4; margin-top: 2px; padding: 5px 6px; }
      .ufi > [hidden] { display: none; }
      .cmt { display: flex; gap: 6px; border-top: 1px solid #fff; }
      .cmt b { color: #3b5998; }
      .cdate { color: #999; display: block; }
      .older { display: block; width: 100%; margin-top: 10px; background: #eceff5; border: 1px solid #d8dfea; color: #3b5998; font-weight: bold; padding: 6px; cursor: pointer; }

      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 6px; }
      .grid img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border: 1px solid #ccc; }

      .ad { display: block; padding: 6px 4px; color: #333; }
      .ad b { display: block; color: #3b5998; }
      .ad:hover { text-decoration: none; background: #f7f7f7; }

      .foot { color: #999; border-top: 1px solid #ccc; padding-top: 8px; padding-bottom: 20px; }

      @media (max-width: 760px) {
        .search, .bar-links a:not(:last-child) { display: none; }
        .page { grid-template-columns: 1fr; }
        .left { display: grid; grid-template-columns: 100px 1fr; gap: 10px; }
        .profile-pic { width: 100px; }
        .left .box { grid-column: 1 / -1; }
        .actions { margin: 0; }
        .right { display: none; }
      }
    </style>
  </body>
</html>
