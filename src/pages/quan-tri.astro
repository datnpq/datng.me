---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout title={`Quản trị | ${config.site.title}`}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <Header />
  <Main pageTitle="🔐 Quản trị góc giao lưu" pageDesc="Duyệt nhật ký, ẩn tin chatbox. Chỉ dành cho chủ nhà.">
    <form id="login" class="win9x mt-6">
      <div class="win9x-title">Đăng nhập</div>
      <div class="win9x-body flex gap-2">
        <input id="token" type="password" autocomplete="current-password" placeholder="ADMIN_TOKEN" required />
        <button class="btn9x flex-none" type="submit">Vào</button>
      </div>
    </form>
    <p id="status" class="mt-3 text-sm" aria-live="polite"></p>

    <div id="panel" hidden>
      <h2 class="mt-6 text-xl font-semibold">Nhật ký chờ duyệt (<span id="n-pending">0</span>)</h2>
      <ul id="pending" class="mt-3 grid gap-3"></ul>
      <h2 class="mt-8 text-xl font-semibold">Nhật ký đang hiện</h2>
      <ul id="approved" class="mt-3 grid gap-3"></ul>
      <h2 class="mt-8 text-xl font-semibold">Chatbox (100 tin gần nhất)</h2>
      <ul id="chat" class="mt-3 grid gap-1 text-sm"></ul>
      <p class="mt-6"><button id="logout" class="btn9x" type="button">Đăng xuất</button></p>
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const KEY = "admin9x";
  let token = "";
  try { token = sessionStorage.getItem(KEY) ?? ""; } catch {}

  const el = (tag: string, cls = "", text = "") => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  };
  const fmt = (ts: number) => new Date(ts).toLocaleString("vi-VN", { timeZone: "Asia/Ho_Chi_Minh" });
  const call = async (body?: unknown) => {
    const res = await fetch("/api/9x/admin", {
      method: body ? "POST" : "GET",
      headers: { authorization: `Bearer ${token}`, "content-type": "application/json" },
      body: body ? JSON.stringify(body) : undefined,
    });
    return res.json().catch(() => ({ ok: false, error: "network" }));
  };
  const btn = (label: string, kind: string, id: number, action: string) => {
    const b = el("button", "btn9x text-xs", label) as HTMLButtonElement;
    b.type = "button";
    b.addEventListener("click", async () => {
      const r = await call({ kind, id, action });
      $("status").textContent = r.ok ? "Xong ✓" : `Lỗi: ${r.error}`;
      load();
    });
    return b;
  };
  type Diary = { id: number; name: string; title: string; mood: string; song: string; content: string; ts: number };
  const diaryItem = (d: Diary, actions: HTMLElement[]) => {
    const li = el("li", "win9x");
    const body = el("div", "win9x-body text-sm");
    body.append(
      el("p", "font-semibold", d.title),
      el("p", "text-muted-foreground text-xs", `${d.name} · ${fmt(d.ts)} · ${d.mood} · ${d.song}`),
      el("p", "mt-2 whitespace-pre-line", d.content)
    );
    const row = el("div", "mt-2 flex gap-2");
    actions.forEach(a => row.appendChild(a));
    body.appendChild(row);
    li.appendChild(body);
    return li;
  };

  const load = async () => {
    const r = await call();
    if (!r.ok) {
      $("status").textContent =
        r.error === "unauthorized" ? "Sai token." : r.error === "not_configured" ? "Chưa đặt ADMIN_TOKEN trên Cloudflare." : `Lỗi: ${r.error}`;
      $("panel").hidden = true;
      $("login").hidden = false;
      return;
    }
    $("login").hidden = true;
    $("panel").hidden = false;
    $("n-pending").textContent = String(r.pending.length);
    $("pending").replaceChildren(...r.pending.map((d: Diary) => diaryItem(d, [btn("Duyệt", "diary", d.id, "approve"), btn("Xoá", "diary", d.id, "delete")])));
    $("approved").replaceChildren(...r.diary.map((d: Diary) => diaryItem(d, [btn("Xoá", "diary", d.id, "delete")])));
    $("chat").replaceChildren(
      ...r.chat.map((m: { id: number; name: string; msg: string; ts: number; hidden: number }) => {
        const li = el("li", "flex items-start justify-between gap-2" + (m.hidden ? " opacity-50" : ""));
        li.append(el("span", "break-words", `${fmt(m.ts)} · ${m.name}: ${m.msg}`), m.hidden ? btn("Hiện", "chat", m.id, "show") : btn("Ẩn", "chat", m.id, "hide"));
        return li;
      })
    );
  };

  $("login").addEventListener("submit", e => {
    e.preventDefault();
    token = ($("token") as HTMLInputElement).value.trim();
    try { sessionStorage.setItem(KEY, token); } catch {}
    load();
  });
  $("logout").addEventListener("click", () => {
    token = "";
    try { sessionStorage.removeItem(KEY); } catch {}
    $("panel").hidden = true;
    $("login").hidden = false;
  });
  if (token) load();
</script>
