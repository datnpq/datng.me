---
/** "Mỗi tuần một bài hát" — YouTube embed from now.md frontmatter. */
import { getEntry } from "astro:content";
const now = await getEntry("pages", "now");
const song = now?.data.song;
const songTitle = now?.data.songTitle;
function videoId(s: string): string | undefined {
  const m = s.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/);
  return m?.[1] ?? (/^[\w-]{11}$/.test(s) ? s : undefined);
}
const id = song ? videoId(song) : undefined;
---

{
  id && (
    <section id="song" class="mt-8">
      <h2 class="text-xl font-semibold tracking-wide">
        🎵 Mỗi tuần một bài hát
      </h2>
      {songTitle && (
        <p class="text-muted-foreground mt-1 text-sm">Đang nghe: {songTitle}</p>
      )}
      <div class="mt-3 aspect-video w-full max-w-xl overflow-hidden rounded-lg border">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${id}`}
          title={songTitle ?? "Song of the week"}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="h-full w-full"
        />
      </div>
    </section>
  )
}
