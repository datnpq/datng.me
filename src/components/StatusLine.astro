---
/**
 * Blast (Yahoo! 360 speech bubble) + Mood, from src/content/pages/now.md.
 * variant="blast" renders only the blast line; variant="mood" only the mood.
 */
import { getEntry } from "astro:content";
type Props = { variant: "blast" | "mood" };
const { variant } = Astro.props;
const now = await getEntry("pages", "now");
const blast = now?.data.blast;
const mood = now?.data.mood;
---

{
  variant === "blast" && blast && (
    <div id="blast" class="text-sm">
      <a
        href="/now/"
        class="hover:text-accent group inline-flex items-center gap-1.5"
        title="Blast — xem trang /now"
      >
        <span aria-hidden="true">💬</span>
        <span class="decoration-dashed underline-offset-4 group-hover:underline">
          {blast}
        </span>
      </a>
    </div>
  )
}
{
  variant === "mood" && mood && (
    <div class="status-line mt-3 flex items-center gap-1.5 text-sm">
      <span class="text-muted-foreground">Mood:</span>
      <span class="text-foreground">{mood}</span>
    </div>
  )
}
