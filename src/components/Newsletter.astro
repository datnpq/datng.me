---
/**
 * Newsletter signup. Posts to /api/subscribe (worker/index.ts → Resend).
 */
type Props = { class?: string };
const { class: className } = Astro.props;
---

<section
  id="newsletter"
  class:list={[
    "border-border/60 bg-muted/15 rounded-2xl border p-6 sm:p-8",
    className,
  ]}
>
  <div
    class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="sm:max-w-sm">
      <h2 class="text-xl font-semibold">📬 Nhận bài mới qua email</h2>
      <p class="text-muted-foreground mt-1 text-sm">
        Khi có bài mới mình sẽ gửi một email. Không spam, huỷ lúc nào cũng được.
      </p>
    </div>
    <form
      id="newsletter-form"
      class="flex w-full flex-col gap-2 sm:w-auto sm:min-w-80"
      novalidate
    >
      <div class="flex gap-2">
        <label for="newsletter-email" class="sr-only">Email</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="ban@email.com"
          class="border-border bg-background focus:border-accent w-full rounded-lg border px-3 py-2 text-sm outline-none"
        />
        <!-- honeypot: bots fill this, humans never see it -->
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute -left-[9999px] h-0 w-0 opacity-0"
        />
        <button
          type="submit"
          class="bg-accent text-background rounded-lg px-4 py-2 text-sm font-medium whitespace-nowrap transition-all hover:opacity-90 active:scale-95 disabled:opacity-60"
        >
          Đăng ký
        </button>
      </div>
      <p id="newsletter-msg" class="min-h-5 text-sm" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  function setupNewsletter() {
    const form = document.getElementById(
      "newsletter-form"
    ) as HTMLFormElement | null;
    if (!form || form.dataset.ready) return;
    form.dataset.ready = "1";
    const msg = form.querySelector("#newsletter-msg") as HTMLElement;
    const btn = form.querySelector("button") as HTMLButtonElement;
    const email = form.querySelector("#newsletter-email") as HTMLInputElement;

    form.addEventListener("submit", async e => {
      e.preventDefault();
      msg.textContent = "";
      msg.className = "min-h-5 text-sm";
      if (!email.checkValidity()) {
        msg.textContent = "Email chưa đúng định dạng.";
        msg.classList.add("text-red-500");
        return;
      }
      btn.disabled = true;
      btn.textContent = "Đang gửi…";
      try {
        const res = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          error?: string;
        };
        if (res.ok && data.ok) {
          msg.textContent = "Đã đăng ký! Cảm ơn bạn 🎉";
          msg.classList.add("text-accent");
          form.reset();
        } else if (data.error === "invalid_email") {
          msg.textContent = "Email chưa đúng định dạng.";
          msg.classList.add("text-red-500");
        } else if (data.error === "not_configured") {
          msg.textContent = "Newsletter đang được thiết lập, thử lại sau nhé.";
          msg.classList.add("text-muted-foreground");
        } else {
          msg.textContent = "Có lỗi xảy ra, thử lại sau nhé.";
          msg.classList.add("text-red-500");
        }
      } catch {
        msg.textContent = "Không kết nối được, thử lại sau nhé.";
        msg.classList.add("text-red-500");
      } finally {
        btn.disabled = false;
        btn.textContent = "Đăng ký";
      }
    });
  }
  document.addEventListener("astro:page-load", setupNewsletter);
</script>
