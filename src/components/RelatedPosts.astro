---
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";

type Props = { posts: CollectionEntry<"posts">[] };
const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section id="related" class="mt-10">
      <h2 class="text-xl font-semibold tracking-wide">Bài liên quan</h2>
      <ul>
        {posts.map(p => (
          <Card variant="h3" {...p} />
        ))}
      </ul>
    </section>
  )
}
